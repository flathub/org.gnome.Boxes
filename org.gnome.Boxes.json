{
    "app-id": "org.gnome.Boxes",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.vala"
    ],
    "build-options": {
        "prepend-path": "/usr/lib/sdk/vala/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/vala/lib"
    },
    "command": "gnome-boxes",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--device=all",
        "--system-talk-name=org.freedesktop.timedate1",
        "--talk-name=org.gnome.ControlCenter",
        "--talk-name=org.gnome.Settings",
        "--filesystem=xdg-run/dconf",
        "--filesystem=~/.config/dconf:ro",
        "--filesystem=host",
        "--talk-name=ca.desrt.dconf",
        "--env=DCONF_USER_CONFIG_DIR=.config/dconf"
    ],
    "cleanup": [
        "/usr",
        "'*.a'",
        "'*.la'",
        "/include",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig"
    ],
    "add-extensions": {
        "org.gnome.Boxes.Extension.OsinfoDb": {
            "version": "stable",
            "directory": "share/osinfo",
            "no-autodownload": false,
            "autodelete": true
        }
    },
    "modules": [
        {
            "name": "libvirt-glib",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.com/libvirt/libvirt-glib/-/archive/v5.0.0/libvirt-glib-v5.0.0.tar.gz",
                    "sha256": "b7ffc65e1e0ed014b5e5bcfbb9574cd56d103eeed974b6229dbf8c62975d16b5"
                }
            ],
            "modules": [
                {
                    "name": "libnl",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/thom311/libnl/releases/download/libnl3_12_0/libnl-3.12.0.tar.gz",
                            "sha256": "fc51ca7196f1a3f5fdf6ffd3864b50f4f9c02333be28be4eeca057e103c0dd18"
                        }
                    ]
                },
                {
                    "name": "libtirpc",
                    "config-opts": [
                        "--disable-gssapi",
                        "--libdir=/app/lib"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://downloads.sourceforge.net/sourceforge/libtirpc/libtirpc-1.3.8.tar.bz2",
                            "sha256": "8839959bfcc7a0f4c609d8e4f53f1c67ae33de23775ec35beb39ff15adf11920"
                        }
                    ]
                },
                {
                    "name": "rpcsvc-proto",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/thkukuk/rpcsvc-proto/releases/download/v1.4.4/rpcsvc-proto-1.4.4.tar.xz",
                            "sha256": "81c3aa27edb5d8a18ef027081ebb984234d5b5860c65bd99d4ac8f03145a558b"
                        }
                    ]
                },
                {
                    "name": "libvirt",
                    "builddir": true,
                    "buildsystem": "meson",
                    "build-options": {
                        "cflags": "-I/app/include/tirpc -ltirpc"
                    },
                    "config-opts": [
                        "-Daudit=disabled",
                        "-Dexpensive_tests=disabled",
                        "-Dgit_werror=disabled",
                        "-Ddocs=disabled",
                        "-Dtests=disabled",
                        "-Dapparmor=disabled",
                        "-Dbash_completion=disabled",
                        "-Dsbindir=/app/bin/",
                        "-Drpath=enabled",
                        "-Ddriver_qemu=enabled"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://download.libvirt.org/libvirt-12.9.0.tar.xz",
                            "sha256": "dcf579d8a949f4cbf56820529d48f200382a48ea12855ffded7c16a189353cd7"
                        },
                        {
                            "type": "patch",
                            "path": "libvirt-use-monitor-in-xdg-runtime-dir.patch"
                        }
                    ],
                    "modules": [
                        {
                            "name": "json-c",
                            "buildsystem": "cmake",
                            "sources": [
                                {
                                    "type": "archive",
                                    "url": "https://github.com/json-c/json-c/releases/download/json-c-0.19-20260627/json-c-0.19.tar.gz",
                                    "sha256": "37ad0249902e301bd9052bf712e511fcc6acff4ecaad4b5900aad9ce564e26de"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "name": "spice-gtk",
            "buildsystem": "meson",
            "build-options": {
                "env": {
                    "PYTHONPATH": "/app"
                }
            },
            "config-opts": [
                "-Dvapi=enabled",
                "-Dwebdav=enabled",
                "-Dgtk_doc=disabled",
                "-Dusbredir=disabled",
                "-Dpolkit=disabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.freedesktop.org/-/project/64/uploads/88f5d31a961da9921add46ca3f0be904/spice-gtk-0.43.tar.xz",
                    "sha256": "cee26e5b2d22909f35b40a94398d1e863ca3962ee46494ca97aab206abc3203b"
                }
            ],
            "modules": [
                {
                    "name": "spice-protocol",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/releases/spice-protocol-0.14.5.tar.xz",
                            "sha256": "baf58449f6e89d19f475899ad5fb9196fdc46c03cc53233f4e39cf2978f9cff7"
                        }
                    ]
                },
                {
                    "name": "phodav",
                    "buildsystem": "meson",
                    "config-opts": [
                        "-Dsystemdsystemunitdir=/app/lib/systemd/system",
                        "-Dudevrulesdir=usr/lib/udev/rules.d"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://download.gnome.org/sources/phodav/3.2/phodav-3.2.tar.xz",
                            "sha256": "93c993066ab3aebd5b539bab9d731eac43abbb750109c895f151ca3c74a5fc82"
                        }
                    ]
                },
                {
                    "name": "python-pyparsing",
                    "buildsystem": "simple",
                    "build-commands": [
                        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pyparsing\" --no-build-isolation"
                    ],
                    "sources": [
                        {
                            "type": "file",
                            "url": "https://files.pythonhosted.org/packages/38/bb/d215ee7c73b61497b28a5503f9f53523f294fcc936762b7caf90e0c1c2b5/pyparsing-3.3.3-py3-none-any.whl",
                            "sha256": "ece8c00a69cf01b45d0b1dedabb469c90d8caf996d4fda40f147627a122849a4"
                        }
                    ]
                },
                {
                    "name": "libcacard",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/libcacard/libcacard-2.8.2.tar.xz",
                            "sha256": "45fc28a6ff3c7a359d4448132ca190f0a9c760540c445dba4597a5b71de40f68"
                        }
                    ]
                },
                {
                    "name": "spice",
                    "config-opts": [
                        "--disable-lz4",
                        "--disable-manual",
                        "--disable-test"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/releases/spice-0.16.0.tar.bz2",
                            "sha256": "0a6ec9528f05371261bbb2d46ff35e7b5c45ff89bb975a99af95a5f20ff4717d"
                        }
                    ]
                }
            ]
        },
        {
            "name": "qemu",
            "config-opts": [
                "--disable-user",
                "--enable-kvm",
                "--enable-spice",
                "--enable-opengl",
                "--enable-virglrenderer",
                "--enable-usb-redir",
                "--enable-smartcard",
                "--enable-slirp",
                "--python=/bin/python3",
                "--target-list=x86_64-softmmu,i386-softmmu"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.qemu.org/qemu-11.1.3.tar.xz",
                    "sha256": "5a8289c7940dc77d3873c81a6c29ba3afe1446fc9d36e77fa1658cdbecb84b22"
                }
            ],
            "modules": [
                {
                    "name": "slirp",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v4.9.7/libslirp-v4.9.7.tar.gz",
                            "sha256": "d2567fa06a6357c7755d61c67293b2c0bf069b3f2173bde6b76cf768529a1938"
                        }
                    ]
                },
                {
                    "name": "usbredir",
                    "buildsystem": "meson",
                    "config-opts": [
                        "-Dtools=disabled"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/usbredir/usbredir-0.15.0.tar.xz",
                            "sha256": "6dc2a380277688a068191245dac2ab7063a552999d8ac3ad8e841c10ff050961"
                        }
                    ]
                },
                {
                    "name": "virglrenderer",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/1.3.0/virglrenderer-1.3.0.tar.gz",
                            "sha256": "065bc56e89e6f631f96101cd62eba0748e48eb888b434edc86e89d05395e76f3"
                        }
                    ],
                    "modules": [
                        {
                            "name": "python3-pyyaml",
                            "buildsystem": "simple",
                            "build-commands": [
                                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pyyaml\" --no-build-isolation"
                            ],
                            "sources": [
                                {
                                    "type": "file",
                                    "url": "https://files.pythonhosted.org/packages/05/8e/961c0007c59b8dd7729d542c61a4d537767a59645b82a0b521206e1e25c2/pyyaml-6.0.3.tar.gz",
                                    "sha256": "d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "python3-distlib",
                    "buildsystem": "simple",
                    "build-commands": [
                        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"distlib\" --no-build-isolation"
                    ],
                    "sources": [
                        {
                            "type": "file",
                            "url": "https://files.pythonhosted.org/packages/c1/2b/238f02a4927fa2e27aa995371d240a468b52e42eae44a678434aff736b38/distlib-0.4.4-py2.py3-none-any.whl",
                            "sha256": "cf09d55b1e85a89576b036aeb71550bfd68320f3f21761ca329eadadad918638"
                        }
                    ]
                },
                {
                    "name": "dtc",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://git.kernel.org/pub/scm/utils/dtc/dtc.git/snapshot/v1.8.1.tar.gz",
                            "sha256": "a6bea318d8d4c80ad9637a0c94571ba1148d482604006f02b70e70126ac2310b"
                        }
                    ]
                }
            ]
        },
        {
            "name": "libosinfo",
            "buildsystem": "meson",
            "config-opts": [
                "-Dwith-pci-ids-path=/app/share/hwdata/pci.ids",
                "-Dwith-usb-ids-path=/app/share/hwdata/usb.ids"
            ],
            "post-install": [
                "install -Dm644 ../pci.ids /app/share/hwdata/pci.ids",
                "install -Dm644 ../usb.ids /app/share/hwdata/usb.ids"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.com/libosinfo/libosinfo.git",
                    "tag": "v1.12.0",
                    "commit": "b505ef5161d2552102a743acd4ad83298d3d8f99",
                    "x-checker-data": {
                        "type": "git",
                        "url": "https://gitlab.com/libosinfo/libosinfo.git",
                        "tag-pattern": "^(v[\\d.]+)$"
                    }
                },
                {
                    "type": "file",
                    "path": "pci.ids"
                },
                {
                    "type": "file",
                    "path": "usb.ids"
                },
                {
                    "type": "patch",
                    "path": "libosinfo-osinfo-db-loader-workaround.patch"
                },
                {
                    "type": "patch",
                    "path": "libosinfo-dont-use-deprecated-libxml2-api.patch"
                }
            ],
            "modules": [
                {
                    "name": "cdrkit",
                    "buildsystem": "cmake-ninja",
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://github.com/Distrotech/cdrkit",
                            "commit": "7b4bb72389ea5ea3ecc94545036dcff4728ec38a"
                        },
                        {
                            "type": "patch",
                            "path": "genisoimage-extern.patch"
                        },
                        {
                            "type": "patch",
                            "path": "cdrkit-build-fix.patch"
                        },
                        {
                            "type": "patch",
                            "path": "cdrkit-add-cmake_minimum_required.patch"
                        }
                    ]
                },
                {
                    "name": "osinfo-db-tools",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://gitlab.com/libosinfo/osinfo-db-tools.git",
                            "tag": "v1.12.0",
                            "commit": "e5564be303bfac49cc3490bd0fada342cd65566f",
                            "x-checker-data": {
                                "type": "git",
                                "url": "https://gitlab.com/libosinfo/osinfo-db-tools.git",
                                "tag-pattern": "^(v[\\d.]+)$"
                            }
                        }
                    ]
                },
                {
                    "name": "osinfo-db",
                    "buildsystem": "simple",
                    "builddir": true,
                    "build-commands": [
                        "make",
                        "osinfo-db-import --dir /app/share/osinfo/ osinfo-db-*.tar.xz"
                    ],
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://gitlab.com/libosinfo/osinfo-db.git",
                            "tag": "v20260812",
                            "commit": "ae7a0bfe36940a7dde23fcd95ce60c0608cb7e33",
                            "x-checker-data": {
                                "type": "git",
                                "url": "https://gitlab.com/libosinfo/osinfo-db.git",
                                "tag-pattern": "^(v\\d+)$"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "govf",
            "config-opts": [
                "--libdir=/app/lib"
            ],
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "disable-shallow-clone": true,
                    "url": "https://gitlab.gnome.org/felipeborges/libovf-glib.git",
                    "commit": "52d35970d385d0beda4b765a7264d77e79736549"
                }
            ]
        },
        {
            "name": "libhandy",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libhandy/1.8/libhandy-1.8.3.tar.xz",
                    "sha256": "05b497229073ff557f10b326e074c5066f8743a302d4820ab97bcb5cd2dab087"
                }
            ]
        },
        {
            "name": "gnome-boxes",
            "buildsystem": "meson",
            "config-opts": [
                "-Dflatpak=true",
                "-Ddistributor_name=gnome-boxes-flathub",
                "-Ddistributor_version=50"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gnome-boxes/50/gnome-boxes-50.0.tar.xz",
                    "sha256": "fd6a5de18d1090946ca99f1f5a34aa3e15dc8183f6a72226e8d1504a13672d67",
                    "x-checker-data": {
                        "is-important": true,
                        "type": "gnome",
                        "name": "gnome-boxes"
                    }
                },
                {
                    "type": "patch",
                    "path": "fix-metainfo.patch"
                }
            ]
        }
    ]
}
