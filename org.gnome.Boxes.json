{
    "app-id": "org.gnome.Boxes",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.vala"
    ],
    "build-options": {
        "prepend-path": "/usr/lib/sdk/vala/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/vala/lib"
    },
    "command": "gnome-boxes",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--device=all",
        "--system-talk-name=org.freedesktop.timedate1",
        "--talk-name=org.gnome.ControlCenter",
        "--talk-name=org.gnome.Settings",
        "--filesystem=xdg-run/dconf",
        "--filesystem=~/.config/dconf:ro",
        "--filesystem=host",
        "--talk-name=ca.desrt.dconf",
        "--env=DCONF_USER_CONFIG_DIR=.config/dconf"
    ],
    "cleanup": [
        "/usr",
        "'*.a'",
        "'*.la'",
        "/include",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig"
    ],
    "add-extensions": {
        "org.gnome.Boxes.Extension.OsinfoDb": {
            "version": "stable",
            "directory": "share/osinfo",
            "no-autodownload": false,
            "autodelete": true
        }
    },
    "modules": [
        {
            "name": "libvirt-glib",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.com/libvirt/libvirt-glib/-/archive/v5.0.0/libvirt-glib-v5.0.0.tar.gz",
                    "sha256": "b7ffc65e1e0ed014b5e5bcfbb9574cd56d103eeed974b6229dbf8c62975d16b5"
                }
            ],
            "modules": [
                {
                    "name": "libnl",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/thom311/libnl/releases/download/libnl3_12_0/libnl-3.12.0.tar.gz",
                            "sha256": "fc51ca7196f1a3f5fdf6ffd3864b50f4f9c02333be28be4eeca057e103c0dd18"
                        }
                    ]
                },
                {
                    "name": "libtirpc",
                    "config-opts": [
                        "--disable-gssapi",
                        "--libdir=/app/lib"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://downloads.sourceforge.net/sourceforge/libtirpc/libtirpc-1.3.7.tar.bz2",
                            "sha256": "b47d3ac19d3549e54a05d0019a6c400674da716123858cfdb6d3bdd70a66c702"
                        }
                    ]
                },
                {
                    "name": "rpcsvc-proto",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/thkukuk/rpcsvc-proto/releases/download/v1.4.4/rpcsvc-proto-1.4.4.tar.xz",
                            "sha256": "81c3aa27edb5d8a18ef027081ebb984234d5b5860c65bd99d4ac8f03145a558b"
                        }
                    ]
                },
                {
                    "name": "libvirt",
                    "builddir": true,
                    "buildsystem": "meson",
                    "build-options": {
                        "cflags": "-I/app/include/tirpc -ltirpc"
                    },
                    "config-opts": [
                        "-Daudit=disabled",
                        "-Dexpensive_tests=disabled",
                        "-Dgit_werror=disabled",
                        "-Ddocs=disabled",
                        "-Dtests=disabled",
                        "-Dapparmor=disabled",
                        "-Dbash_completion=disabled",
                        "-Dsbindir=/app/bin/",
                        "-Drpath=enabled",
                        "-Ddriver_qemu=enabled"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://download.libvirt.org/libvirt-12.6.0.tar.xz",
                            "sha256": "1592256deb76fc94028ff083a4d9f06a74f3b92a66a1794f37bc26f21430c888"
                        },
                        {
                            "type": "patch",
                            "path": "libvirt-use-monitor-in-xdg-runtime-dir.patch"
                        }
                    ],
                    "modules": [
                        {
                            "name": "json-c",
                            "buildsystem": "cmake",
                            "config-opts": [
                                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
                            ],
                            "sources": [
                                {
                                    "type": "git",
                                    "url": "https://github.com/json-c/json-c",
                                    "tag": "json-c-0.18-20240915",
                                    "commit": "41a55cfcedb54d9c1874f2f0eb07b504091d7e37"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "name": "spice-gtk",
            "buildsystem": "meson",
            "build-options": {
                "env": {
                    "PYTHONPATH": "/app"
                }
            },
            "config-opts": [
                "-Dvapi=enabled",
                "-Dwebdav=enabled",
                "-Dgtk_doc=disabled",
                "-Dusbredir=disabled",
                "-Dpolkit=disabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.freedesktop.org/-/project/64/uploads/88f5d31a961da9921add46ca3f0be904/spice-gtk-0.43.tar.xz",
                    "sha256": "cee26e5b2d22909f35b40a94398d1e863ca3962ee46494ca97aab206abc3203b"
                }
            ],
            "modules": [
                {
                    "name": "spice-protocol",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/releases/spice-protocol-0.14.5.tar.xz",
                            "sha256": "baf58449f6e89d19f475899ad5fb9196fdc46c03cc53233f4e39cf2978f9cff7"
                        }
                    ]
                },
                {
                    "name": "phodav",
                    "buildsystem": "meson",
                    "config-opts": [
                        "-Dsystemdsystemunitdir=/app/lib/systemd/system",
                        "-Dudevrulesdir=usr/lib/udev/rules.d"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://download.gnome.org/sources/phodav/3.0/phodav-3.0.tar.xz",
                            "sha256": "392ec2d06d50300dcff1ef269a2a985304e29bce3520002fca29f2edc1d138d1"
                        }
                    ]
                },
                {
                    "name": "python-pyparsing",
                    "buildsystem": "simple",
                    "build-commands": [
                        "pip3 install --prefix=/app pyparsing-3.3.2-py3-none-any.whl"
                    ],
                    "sources": [
                        {
                            "type": "file",
                            "url": "https://files.pythonhosted.org/packages/10/bd/c038d7cc38edc1aa5bf91ab8068b63d4308c66c4c8bb3cbba7dfbc049f9c/pyparsing-3.3.2-py3-none-any.whl",
                            "sha256": "850ba148bd908d7e2411587e247a1e4f0327839c40e2e5e6d05a007ecc69911d"
                        }
                    ]
                },
                {
                    "name": "libcacard",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/libcacard/libcacard-2.8.2.tar.xz",
                            "sha256": "45fc28a6ff3c7a359d4448132ca190f0a9c760540c445dba4597a5b71de40f68"
                        }
                    ]
                },
                {
                    "name": "spice",
                    "config-opts": [
                        "--disable-lz4",
                        "--disable-manual",
                        "--disable-test"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/releases/spice-0.16.0.tar.bz2",
                            "sha256": "0a6ec9528f05371261bbb2d46ff35e7b5c45ff89bb975a99af95a5f20ff4717d"
                        }
                    ]
                }
            ]
        },
        {
            "name": "qemu",
            "config-opts": [
                "--disable-user",
                "--enable-kvm",
                "--enable-spice",
                "--enable-opengl",
                "--enable-virglrenderer",
                "--enable-usb-redir",
                "--enable-smartcard",
                "--enable-slirp",
                "--python=/bin/python3",
                "--target-list=x86_64-softmmu,i386-softmmu"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.qemu.org/qemu-11.0.3.tar.xz",
                    "sha256": "da5fcffc32762820568b828ed430a728864d34d50b6d2f30358597760cbb0523"
                }
            ],
            "modules": [
                {
                    "name": "slirp",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://gitlab.freedesktop.org/-/project/2767/uploads/bdcbb727b502f93d312e631cc0980055/libslirp-4.9.3.tar.xz",
                            "sha256": "be4edb819fb29a51dcbeeb3ada7e39b05fd0841ce2a1259187ba928ee197cf45"
                        }
                    ]
                },
                {
                    "name": "usbredir",
                    "buildsystem": "meson",
                    "config-opts": [
                        "-Dtools=disabled"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.spice-space.org/download/usbredir/usbredir-0.15.0.tar.xz",
                            "sha256": "6dc2a380277688a068191245dac2ab7063a552999d8ac3ad8e841c10ff050961"
                        }
                    ]
                },
                {
                    "name": "virglrenderer",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/1.3.0/virglrenderer-1.3.0.tar.gz",
                            "sha256": "065bc56e89e6f631f96101cd62eba0748e48eb888b434edc86e89d05395e76f3"
                        }
                    ],
                    "modules": [
                        {
                            "name": "python3-pyyaml",
                            "buildsystem": "simple",
                            "build-commands": [
                                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pyyaml\" --no-build-isolation"
                            ],
                            "sources": [
                                {
                                    "type": "file",
                                    "url": "https://files.pythonhosted.org/packages/05/8e/961c0007c59b8dd7729d542c61a4d537767a59645b82a0b521206e1e25c2/pyyaml-6.0.3.tar.gz",
                                    "sha256": "d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "python3-distlib",
                    "buildsystem": "simple",
                    "build-commands": [
                        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"distlib\" --no-build-isolation"
                    ],
                    "sources": [
                        {
                            "type": "file",
                            "url": "https://files.pythonhosted.org/packages/02/08/9c41fb51ab5b43eb21674aff13df270e8ba6c4b29c8624e328dc7a9482af/distlib-0.4.3-py2.py3-none-any.whl",
                            "sha256": "4b0ce306c966eb73bc3a7b6abad017c556dadd92c44701562cd528ac7fde4d5b"
                        }
                    ]
                },
                {
                    "name": "dtc",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://git.kernel.org/pub/scm/utils/dtc/dtc.git/snapshot/v1.8.1.tar.gz",
                            "sha256": "a6bea318d8d4c80ad9637a0c94571ba1148d482604006f02b70e70126ac2310b"
                        }
                    ]
                }
            ]
        },
        {
            "name": "libosinfo",
            "buildsystem": "meson",
            "config-opts": [
                "-Dwith-pci-ids-path=/app/share/hwdata/pci.ids",
                "-Dwith-usb-ids-path=/app/share/hwdata/usb.ids"
            ],
            "post-install": [
                "install -Dm644 ../pci.ids /app/share/hwdata/pci.ids",
                "install -Dm644 ../usb.ids /app/share/hwdata/usb.ids"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.com/libosinfo/libosinfo.git",
                    "tag": "v1.12.0",
                    "commit": "b505ef5161d2552102a743acd4ad83298d3d8f99",
                    "x-checker-data": {
                        "type": "git",
                        "url": "https://gitlab.com/libosinfo/libosinfo.git",
                        "tag-pattern": "^(v[\\d.]+)$"
                    }
                },
                {
                    "type": "file",
                    "path": "pci.ids"
                },
                {
                    "type": "file",
                    "path": "usb.ids"
                },
                {
                    "type": "patch",
                    "path": "libosinfo-osinfo-db-loader-workaround.patch"
                },
                {
                    "type": "patch",
                    "path": "libosinfo-dont-use-deprecated-libxml2-api.patch"
                }
            ],
            "modules": [
                {
                    "name": "cdrkit",
                    "buildsystem": "cmake-ninja",
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://github.com/Distrotech/cdrkit",
                            "commit": "7b4bb72389ea5ea3ecc94545036dcff4728ec38a"
                        },
                        {
                            "type": "patch",
                            "path": "genisoimage-extern.patch"
                        },
                        {
                            "type": "patch",
                            "path": "cdrkit-build-fix.patch"
                        },
                        {
                            "type": "patch",
                            "path": "cdrkit-add-cmake_minimum_required.patch"
                        }
                    ]
                },
                {
                    "name": "osinfo-db-tools",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://gitlab.com/libosinfo/osinfo-db-tools.git",
                            "tag": "v1.12.0",
                            "commit": "e5564be303bfac49cc3490bd0fada342cd65566f",
                            "x-checker-data": {
                                "type": "git",
                                "url": "https://gitlab.com/libosinfo/osinfo-db-tools.git",
                                "tag-pattern": "^(v[\\d.]+)$"
                            }
                        }
                    ]
                },
                {
                    "name": "osinfo-db",
                    "buildsystem": "simple",
                    "builddir": true,
                    "build-commands": [
                        "make",
                        "osinfo-db-import --dir /app/share/osinfo/ osinfo-db-*.tar.xz"
                    ],
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://gitlab.com/libosinfo/osinfo-db.git",
                            "tag": "v20251212",
                            "commit": "70fe571c605541e7be76b50f430c1cd13959c5b9",
                            "x-checker-data": {
                                "type": "git",
                                "url": "https://gitlab.com/libosinfo/osinfo-db.git",
                                "tag-pattern": "^(v\\d+)$"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "govf",
            "config-opts": [
                "--libdir=/app/lib"
            ],
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "disable-shallow-clone": true,
                    "url": "https://gitlab.gnome.org/felipeborges/libovf-glib.git",
                    "commit": "52d35970d385d0beda4b765a7264d77e79736549"
                }
            ]
        },
        {
            "name": "libportal",
            "buildsystem": "meson",
            "config-opts": [
                "-Dbackend-gtk3=enabled",
                "-Dbackend-gtk4=disabled",
                "-Ddocs=false",
                "-Dtests=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/flatpak/libportal",
                    "tag": "0.10.0",
                    "commit": "c23024018c8eb076549a1517fcb2d7f80d3e2ed5",
                    "x-checker-data": {
                        "type": "git",
                        "url": "https://github.com/flatpak/libportal",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name": "gnome-boxes",
            "buildsystem": "meson",
            "config-opts": [
                "-Dflatpak=true",
                "-Ddistributor_name=gnome-boxes-flathub",
                "-Ddistributor_version=50"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gnome-boxes/50/gnome-boxes-50.0.tar.xz",
                    "sha256": "fd6a5de18d1090946ca99f1f5a34aa3e15dc8183f6a72226e8d1504a13672d67",
                    "x-checker-data": {
                        "is-important": true,
                        "type": "gnome",
                        "name": "gnome-boxes"
                    }
                }
            ]
        }
    ]
}
